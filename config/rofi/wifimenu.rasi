configuration {
  location: 3;
  xoffset: -45;
  yoffset: 45;
}

* {
  /* Paleta Red Team Stealth */
  //bg: #1A1A1A;
  bg: #000000;
  fg: #c5c8c6;
  sel: #FF0033;
  font: "Hack Nerd Font 12";
}

window {
  background-color: @bg;
  border: 1px;
  border-color: #333333;
  border-radius: 8px;
  padding: 10px;
  width: 30%;
}

mainbox, listview, element {
  background-color: @bg;
}

listview {
  lines: 10;
  fixed-height: true;
  padding: 6px;
  spacing: 6px;
}

element {
  background-color: @bg;
  text-color: @fg;
  padding: 6px 12px;
}

element-text {
  highlight: bold italic;
  /* El truco mágico: heredar color para no dejar "parches" negros */
  text-color: inherit;
  background-color: inherit;
}

element selected {
  background-color: @sel;
  text-color: #ffffff; /* Texto blanco puro para máximo contraste sobre el rojo láser */
  border-radius: 6px;
}

/* --- Barra superior de dmenu (prompt + entrada) --- */
inputbar {
  background-color: @bg;
  text-color: @fg;
  padding: 6px 10px;
  border: 0;
}

prompt {
  background-color: @bg;
  text-color: @sel; /* El texto "Wi-Fi" ahora brilla en rojo */
  padding: 0 6px 0 0;
  font: "Hack Nerd Font Bold 12";
}

textbox-prompt-colon {
  background-color: @bg;
  text-color: @fg;
}

entry {
  background-color: @bg;
  text-color: @fg;
  placeholder-color: @fg;
  cursor: text;
}

mainbox { 
  children: [ message, inputbar, listview ]; 
}

message { 
  background-color: @bg; 
  text-color: @sel; 
  padding: 6px 10px; 
}
